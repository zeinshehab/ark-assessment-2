# Development configuration. Copy to `.env` (gitignored) and fill in your own keys:
#   cp .env.example .env
# Production never reads this file: it uses deploy/.env.prod plus secret files (see deploy/README.md).

APP_ENV=development

# --- Secrets (required) ---
GROQ_KEY=gsk_your_groq_key_here
GEMINI_KEY=your_google_ai_studio_key_here

# --- Optional overrides (defaults shown) ---
# LOG_LEVEL=INFO
# GENERATOR_MODEL=openai/gpt-oss-20b
# REVIEWER_MODEL=gemini-3.5-flash-lite
# REVIEWER_FALLBACK_MODEL=gemini-3.1-flash-lite
# MAX_ITERATIONS=4
# TEST_TIMEOUT_S=15
# PROVIDER_TIMEOUT_S=60
# MAX_PROVIDER_RETRIES=4
# GROQ_TOKENS_PER_MINUTE=8000
# GROQ_DAILY_TOKEN_BUDGET=190000
# GEMINI_MIN_SECONDS_BETWEEN_CALLS=4.5
# BREAKER_FAILURES=3
# BREAKER_COOLDOWN_S=60
# LLM_CACHE_ENABLED=true          # development default; identical prompts are answered from disk for free
# RUN_DEADLINE_S=600
# MAX_CONCURRENT_RUNS=1
# MAX_QUEUED_RUNS=5
# RUNS_PER_USER_PER_HOUR=10
# MAX_TASK_CHARS=4000
# ALLOW_DEMO_INJECTION=true       # development default
# DATA_DIR=.data
