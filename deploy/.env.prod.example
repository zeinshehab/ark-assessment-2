# Production settings (NOT secrets). Copy to deploy/.env.prod on the host and adjust.
# Secrets never go in this file: they are files in deploy/secrets/ (see deploy/README.md).

APP_ENV=production
LOG_LEVEL=INFO

# Cloudflare Access: the app verifies the signed login token on every request.
# Team domain: Zero Trust dashboard > Settings > Custom pages (e.g. myteam.cloudflareaccess.com)
# Audience tag: Access > Applications > your app > Overview > "Application Audience (AUD) Tag"
CF_ACCESS_TEAM_DOMAIN=myteam.cloudflareaccess.com
CF_ACCESS_AUD=replace-with-your-application-aud-tag

# Limits (defaults shown; tuned for the free tiers)
MAX_ITERATIONS=4
RUN_DEADLINE_S=600
MAX_CONCURRENT_RUNS=1
MAX_QUEUED_RUNS=5
RUNS_PER_USER_PER_HOUR=10
PROVIDER_TIMEOUT_S=60
LLM_CACHE_ENABLED=false
ALLOW_DEMO_INJECTION=false
